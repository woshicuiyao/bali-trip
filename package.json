{
  "name": "bali-trip-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite app --config app/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p app --noEmit && vite build app --config app/vite.config.ts",
    "preview": "vite preview app --config app/vite.config.ts --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prebuild": "python3 scripts/prepare-map.py"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@types/leaflet": "1.9.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "zod": "3.25.76"
  }
}
